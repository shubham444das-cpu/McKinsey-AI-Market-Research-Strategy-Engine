# Required: Gemini API key used by every LLM-backed agent
# (planner, extractor, validator, report_writer)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: which Gemini model to use. Defaults to a fast/cheap model if unset.
GEMINI_MODEL=gemini-3.8-flash

# Optional: comma-separated fallback models, tried in order if the primary
# model keeps failing after retries (see utils/llm_client.py).
GEMINI_MODEL_FALLBACK=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Optional: embedding model used by the RAG memory/retrieval layer
# (utils/rag_store.py).
GEMINI_EMBED_MODEL=gemini-embedding-2

# Optional: web search backend for the browsing agent.
#   auto         - Gemini "Grounding with Google Search" first (uses GEMINI_API_KEY),
#                  then googlesearch-python, then a keyless DuckDuckGo scrape
#   gemini       - only Gemini grounding
#   googlesearch - only the googlesearch-python scraper (no key; Google often blocks it)
#   duckduckgo   - only the DuckDuckGo scraper (no key)
# Not sure which one works for you? Run:  python check_search.py
SEARCH_PROVIDER=auto
